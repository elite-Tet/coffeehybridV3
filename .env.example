# Copy to .env.local and fill in. Never commit .env.local.

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/coffeehybrid

# Auth.js — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-me
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_TRUST_HOST=true
# Set to true only while debugging sign-in (logs include user details)
AUTH_DEBUG=false

# Google sign-in (optional; email + password works without it)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Protects /api/cron/expire-orders (Vercel Cron sends it as a Bearer token)
CRON_SECRET=replace-me

# Browser tests (npm run test:e2e). Test accounts only — never real people.
# Create them through /register; promote the admin one in the database (role: "admin").
E2E_CUSTOMER_EMAIL=
E2E_ADMIN_EMAIL=
E2E_PASSWORD=
